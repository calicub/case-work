{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀Rebuild Dashboards",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/dashboard.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🖥️ Start Session Log",
      "type": "shell",
      "command": "case_number=$(grep -m1 '^case_number:' '${file}' | sed 's/^case_number:[[:space:]]*//' | tr -d '\\r') && mkdir -p '${workspaceFolder}/docs/assets/files' && script -q '${workspaceFolder}/docs/assets/files/'\"${case_number}\"-terminal-session-$(date +%Y-%m-%d).txt && ${workspaceFolder}/.venv/bin/python3 '${workspaceFolder}/scripts/insert_assets.py' '${file}' --files",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "📌 Append Terminal Block",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/append_terminal_block.py '${file}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "📋 Copy Prior Actions (Salesforce)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/copy_remote_steps.py '${file}' ${lineNumber}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "📋 Copy Support Notes (Salesforce)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/copy_salesforce_notes.py '${file}' ${lineNumber}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "🔔 Sync Reminders Now",
      "type": "shell",
      "command": "bash '${workspaceFolder}/scripts/sync_reminders.sh' '${file}' && echo 'Reminders synced.'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "📎 Insert Customer Files",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/insert_assets.py '${file}' --files",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "📸 Capture Screenshot",
      "type": "shell",
      "command": "bash '${workspaceFolder}/scripts/capture_screenshot.sh' '${file}'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "📸 Insert Screenshots",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/insert_assets.py '${file}' --screenshots",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "🔁 Toggle File Visibility",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/toggle_view.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "⏰ Install Jira Reminders Schedule",
      "type": "shell",
      "command": "zsh '${workspaceFolder}/integrations/install_schedule.sh'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "🔄 Run Jira Reminders Now",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 '${workspaceFolder}/scripts/jira_reminders.py'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "🟢 Start Zensical",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 scripts/dashboard.py && ${workspaceFolder}/.venv/bin/zensical serve",
      "dependsOn": [
        "🛑 Stop Zensical"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🛑 Stop Zensical",
      "type": "shell",
      "command": "pkill -f 'zensical serve' || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    }
  ]
}
