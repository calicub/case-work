{
  "foam.openDailyNote.onStartup": false,
  "foam.completion.link.style": "markdown",
  "foam.files.ignore": [
    "**/.vscode/**",
    "**/scripts/**",
    "**/docs/dashboards/**"
  ],
  "editor.minimap.enabled": false,
  "editor.formatOnSave": false,
  "workbench.editor.enablePreview": true,
  "breadcrumbs.enabled": false,
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/*.pyc": true,
    "**/site/**": true
  },
  "search.followSymlinks": false,
  "extensions.autoUpdate": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "editor.wordWrap": "on",
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "docs/cases/(active|followup)/.+\\.md$",
        "cmd": "bash ${workspaceFolder}/scripts/sync_reminders.sh ${file}"
      },
      {
        "match": "docs/cases/(active|followup|archive)/.+\\.md$",
        "cmd": "${workspaceFolder}/.venv/bin/python3 ${workspaceFolder}/scripts/insert_assets.py ${file}"
      }
    ]
  },
  "editor.tabSize": 2,
  "terminal.integrated.scrollback": 10000,
  "explorer.autoReveal": false,
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": false
    },
    "editor.formatOnSave": true,
    "editor.snippetSuggestions": "top",
    "editor.wordBasedSuggestions": "off"
  },
  "files.exclude": {
    "docs/guide.md": true,
    "docs/assets/stylesheets": true,
    "docs/dashboards": true,
    "docs/javascripts": true,
    "docs/stylesheets": true,
    "docs/index.md": true,
    "docs/dashboard.md": true,
    "docs/meetings.md": true,
    "docs/pkb.md": true,
    "docs/markdown.md": true
  }
}
