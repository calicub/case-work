{
  "Date with Suffix": {
    "prefix": "today",
    "body": [
      "#### ${CURRENT_MONTH_NAME} ${CURRENT_DATE}"
    ],
    "description": "Inserts date like 'March 3'"
  },
  "Keyboard Key Tag": {
    "prefix": "kbi",
    "body": ["<kbd>${1:key}</kbd>"],
    "description": "Insert a styled keyboard key"
  },
  "Case Description": {
    "prefix": "casedesc",
    "body": [
      "    !!! quote \"Case Description\"",
      "",
      "        $1"
    ],
    "description": "Insert case description admonition"
  },
  "Customer's email response": {
    "prefix": "emailresponse",
    "body": [
      "???+ quote \"Customers email response ${CURRENT_MONTH_NAME} ${CURRENT_DATE}\"",
      "",
      "        $1"
    ],
    "description": "Insert case description admonition"
  },
  "Remote Support Notes": {
    "prefix": "remotenote",
    "body": [
      "    ### 📓 Remote Support ${CURRENT_MONTH}/${CURRENT_DATE}",
      "",
      "    !!! abstract \"<br>\"",
      "",
      "        **Remote support via** ${1|Zoom,Teams,Webex,Phone|}<br>",
      "        **Attendees:** $2",
      "",
      "        ---",
      "        **Details**",
      "",
      "        - $3",
      "",
      "        **Action Plan**",
      "",
      "        - $4"
    ],
    "description": "Insert remote support session notes"
  }
}
