JIRA_URL=https://your-jira-instance
JIRA_TOKEN=your-personal-access-token
JIRA_JQL=assignee = currentUser() AND type = Task AND (status = Open OR status = "In Progress")

# Set to false to show all files in the explorer (useful for editing config/scripts)
HIDE_CLUTTER=true

# Set to false to keep terminals open after tasks finish (useful for reading output)
AUTO_CLOSE_TERMINAL=true
